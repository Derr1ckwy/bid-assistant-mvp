BID_ASSISTANT_DATA_DIR=./data
AUTH_SESSION_TIMEOUT_MINUTES=30
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=180
LLM_CHUNK_CHARS=12000
LLM_MAX_CHUNKS=12
LLM_COMPACT_THRESHOLD_CHARS=60000
LLM_COMPACT_CHUNK_CHARS=8000
LLM_COMPACT_MAX_ITEMS=2
LLM_COMPACT_MAX_OUTPUT_TOKENS=512

# Optional MinerU enhanced parsing. Run setup_mineru.ps1 first.
MINERU_CLI=.mineru-venv/Scripts/mineru.exe
MINERU_PYTHON=
MINERU_BACKEND=pipeline
MINERU_METHOD=ocr
MINERU_LANGUAGE=ch
MINERU_TIMEOUT_SECONDS=1800

# Optional OpenAI-compatible embeddings. Hybrid retrieval starts at the file threshold.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_INSTRUCTION=
VECTOR_MIN_FILES=40

# Reserved for a later RAGFlow adapter.
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
